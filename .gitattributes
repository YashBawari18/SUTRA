# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf diff=python
*.js text eol=lf diff=javascript
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.cypher text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Explicitly declare binary files
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
